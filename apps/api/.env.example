# ===== 数据库 =====
# 本地开发：复制本文件为 .env.dev（Nest start:dev 读取）
# Prisma CLI 默认读 .env：本地可 cp / 链接 .env.dev → .env（均勿提交）
# 生产服务器：由 scripts/install-env/configure.sh 生成/改写 .env（勿用本机密文覆盖）
DATABASE_URL="mysql://users_manager:ChangeMe_DbPass_2026@127.0.0.1:3306/users_manager"

# ===== 服务 =====
# 生产直听 80（无需 Nginx）时设 PORT=80；本地开发可用 3000
PORT=3000
NODE_ENV=development
# 管理端静态目录（可选；默认自动找 apps/admin/dist）
# ADMIN_DIST=/opt/users-manager/apps/admin/dist

# ===== JWT =====
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ===== 敏感字段加密 (交易所key/助记词等) AES-256-GCM, 32字节hex(64位) =====
ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ===== 下单中间件 =====
TRADE_MIDDLEWARE_BASE="http://127.0.0.1:1820"
# CryptoSymbolList 自动刷新间隔毫秒（默认 30 分钟）
SYMBOL_CACHE_REFRESH_MS=1800000
TRADE_SERVICE_KEY=""
# 文档仅支持: en-US / zh-Hans / zh-Hant
TRADE_LANGUAGE="zh-Hans"
TRADE_VERSION_CODE="20260012"
TRADE_CLIENT_TYPE="win"
TRADE_REQUIRE_PROXY=false
TRADE_REQUEST_TIMEOUT_MS=15000

# ===== 跟单 Worker =====
FOLLOWER_ENABLED=true
FOLLOWER_POLL_MS=500
FOLLOWER_MAX_SIGNALS=20
# 信号超时毫秒（优先）；未设则用 SIGNAL_TIMEOUT_SECONDS×1000
SIGNAL_TIMEOUT_MS=60000
SIGNAL_TIMEOUT_SECONDS=60
ORDER_EXPIRE_SECONDS=60
ORDER_WATCH_MS=8000
ORDER_EXPIRE_CHECK_MS=8000
# 仓位对账兜底周期（毫秒）；平仓 EXPIRED/外部撤单会立刻对账
POSITION_RECONCILE_MS=60000
# 同一仓连续平仓失败达此次数 → 标为异常持仓（默认 60）
POSITION_CLOSE_FAIL_ABNORMAL_COUNT=60
# 异常仓自动重试平仓间隔（毫秒，默认 5 分钟）
POSITION_ABNORMAL_RETRY_MS=300000
# 标为异常后继续自动重试的小时数（默认 24；到期后仅人工清除）
POSITION_ABNORMAL_STOP_HOURS=24

# ===== 行情 (Node 采集后转发给 App) =====
MARKET_ENABLED=true
# 正常 90s；封禁优先跟 Retry-After/reset 头，否则按所默认（Bybit10m/币安1m/…），上限 30m
MARKET_POLL_MS=90000
# MARKET_BAN_BACKOFF_MS=   # 可选：无响应头时统一兜底；不配则按所区分
MARKET_BAN_BACKOFF_MIN_MS=5000
MARKET_BAN_BACKOFF_MAX_MS=1800000
MARKET_SOURCE_URL=https://api.binance.com
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT

# ===== 提现热钱包 / 归集 =====
# WITHDRAW_HOT_PRIVATE_KEY=
COLLECTION_ENABLED=false

# ===== 充值 HD 钱包 =====
# 本地开发：可自填测试助记词（勿用于生产）。
# 生产服务器：scripts/install-env/configure.sh 首次会自动生成写入 .env；
#             已有真实助记词后永不覆盖。生成后离线备份，发过充值地址后禁止再改。
# 手工生成示例：
#   npx --yes -p ethers node -e "const {Wallet}=require('ethers');console.log(Wallet.createRandom().mnemonic.phrase)"
HD_MNEMONIC="word1 word2 ... word12"

# ===== 链上充值监听 =====
DEPOSIT_SCAN_ENABLED=true
# 正常 90s；封禁优先响应头，RPC 默认约 5m（可用 DEPOSIT_BAN_BACKOFF_MS 覆盖兜底）
DEPOSIT_SCAN_MS=90000
# DEPOSIT_BAN_BACKOFF_MS=300000
DEPOSIT_BAN_BACKOFF_MAX_MS=1800000
DEPOSIT_PRIMARY_CHAIN=ARB
# 对外开放的充值链，逗号分隔；空=仅主链。加网示例: ARB,BASE
DEPOSIT_ENABLED_CHAINS=ARB
DEPOSIT_MIN_AMOUNT=10
# CHAIN_ARB_RPC=https://arb1.arbitrum.io/rpc
# CHAIN_BASE_RPC=https://mainnet.base.org
# CHAIN_ETH_RPC=https://ethereum.publicnode.com

# ===== 初始平台管理员 (seed) =====
ADMIN_EMAIL="admin@floworder.local"
ADMIN_PASSWORD="admin123456"
