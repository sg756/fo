# 依赖与构建产物
node_modules/
**/node_modules/
dist/
**/dist/
.expo/
*.tsbuildinfo

# 密钥与本机环境（勿提交）
.env
.env.dev
.env.production
.env.*.local
apps/api/.env
apps/api/.env.dev

# 本机 App / 编译路径与 Expo 账号（从同目录 *.example 复制）
apps/mobile/app.json
scripts/mobile/mobile.conf
scripts/deploy-windows/build.conf

# 含本机号码等约定，不进 GitHub
.cursor/rules/no-personal-git.mdc

# Windows 发版组装包（build.ps1 生成）
/dist-release/

# 数据库备份（含用户、交易所 Key、助记词密文）
/backups/
*.sql
/floworder*.sql

# 自动化测试（跑业务不需要，不进仓库）
/apps/api/test/

# 根目录临时抓取/调试文本（不要进仓库）
/_*.txt

# 日志与系统文件
*.log
apps/mobile/expo.log
.DS_Store
Thumbs.db
.idea/
